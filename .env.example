# Local development settings, shared by `docker compose` and the Spring `dev` profile.
# Copy to .env and adjust. .env is git-ignored: never commit real credentials.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_DB=irrigaiq
POSTGRES_USER=irrigaiq
POSTGRES_PASSWORD=irrigaiq_dev_password
POSTGRES_PORT=5432

# --- API ---
SERVER_PORT=8080
# Browser origins allowed to call the API (web app on 5173, Expo web on 8081).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# First administrator, created on startup while no admin exists. 12-72 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@irrigaiq.local
BOOTSTRAP_ADMIN_PASSWORD=IrrigaIQ-Admin-2026!

# --- JWT signing keys (optional in dev) ---
# Without these the dev profile generates an ephemeral key pair on each start, so access tokens
# stop working after a restart (clients transparently refresh). For stable keys:
#   ./scripts/generate-jwt-keys.sh
# JWT_PRIVATE_KEY_LOCATION=file:./secrets/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem
